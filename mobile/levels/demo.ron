// Demo level: "Intake Manifold". Portrait, tuned for a 402x874pt phone view.
// Deliberately coarse field (96x168) — features read big and chunky at the
// target zoom (~54 cells across), in the spirit of PixelJunk Shooter.
// Water pours from the supply pipe at the top; the core intake is at the
// bottom behind a pipework funnel. A molten pocket on the left is the
// player's slag supply; a contaminant pocket on the right threatens purity.
Level(
    name: "Intake Manifold",
    width: 96,
    height: 168,
    seed: 7,
    strata: [
        Stratum(material: "sediment", from: 0.0, to: 0.28),
        Stratum(material: "calcite", from: 0.28, to: 0.55),
        Stratum(material: "vitreous_scale", from: 0.55, to: 0.72),
        Stratum(material: "calcite", from: 0.72, to: 1.01),
    ],
    fill_noise: NoiseSpec(scale: 0.07, octaves: 3, threshold: -0.28),
    cave_noise: NoiseSpec(scale: 0.036, octaves: 3, threshold: 0.38),
    pipes: [
        // Supply pipe stub at the top.
        Rect(x: 42.0, y: 0.0, w: 2.5, h: 9.0),
        Rect(x: 51.5, y: 0.0, w: 2.5, h: 9.0),
        // Intake funnel at the bottom.
        Rect(x: 34.5, y: 147.0, w: 3.0, h: 21.0),
        Rect(x: 58.5, y: 147.0, w: 3.0, h: 21.0),
        Rect(x: 28.5, y: 144.0, w: 9.0, h: 3.0),
        Rect(x: 58.5, y: 144.0, w: 9.0, h: 3.0),
        // A mid-level deck the water must be routed around.
        Rect(x: 15.0, y: 103.5, w: 34.0, h: 3.0),
        Rect(x: 60.0, y: 103.5, w: 22.0, h: 3.0),
    ],
    clears: [
        // Supply channel between the pipe stubs (the emitter lives here).
        Rect(x: 44.5, y: 0.0, w: 7.0, h: 9.0),
        // Spawn chamber under the supply pipe.
        Rect(x: 33.0, y: 7.5, w: 30.0, h: 18.0),
        // Breathing room above the intake funnel.
        Rect(x: 39.0, y: 148.5, w: 18.0, h: 13.5),
    ],
    mineral_veins: [
        MineralVein(x: 21.5, y: 52.0, r: 3.5),
        MineralVein(x: 76.5, y: 42.0, r: 3.5),
        MineralVein(x: 74.0, y: 113.0, r: 4.0),
        MineralVein(x: 31.5, y: 131.0, r: 3.5),
    ],
    emitters: [
        Emitter(x: 48.0, y: 4.5, vx: 0.0, vy: 22.0, rate: 26.0, kind: "water", max: 0),
    ],
    molten_pools: [
        Rect(x: 10.0, y: 77.0, w: 18.0, h: 10.0),
    ],
    contaminant_pools: [
        Rect(x: 68.0, y: 64.5, w: 16.5, h: 8.0),
    ],
    intake: Rect(x: 39.0, y: 160.5, w: 18.0, h: 7.0),
    goal_volume: 200,
    goal_purity: 0.65,
    player_spawn: (48.0, 21.0),
    ambient_heat_base: 0.0,
    ambient_heat_per_depth: 0.0027,
)
