// The additive mechanic: drop water onto a molten blob and verify the contact
// builds solid slag geometry (a dam) in the open cavity.
Scenario(
    level: "../../levels/demo.ron",
    materials: "../../materials/materials.ron",
    steps: 900,
    snapshot_every: 75,
    actions: [
        // Open a cavity mid-level.
        Dig(step: 10, x: 64.0, y: 128.0, r: 8.0),
        Dig(step: 20, x: 58.0, y: 134.0, r: 6.0),
        Dig(step: 30, x: 70.0, y: 134.0, r: 6.0),
        // Molten pool at the cavity floor.
        Blob(step: 60, x: 64.0, y: 132.0, r: 5.0, kind: "molten", count: 60),
        // Water dropped on top from above.
        Blob(step: 240, x: 64.0, y: 120.0, r: 4.5, kind: "water", count: 80),
        Blob(step: 420, x: 64.0, y: 120.0, r: 4.5, kind: "water", count: 80),
    ],
)
